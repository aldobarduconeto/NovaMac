                                                                Padding="4,1"
                                                                ToolTipService.ToolTip="Atualizar sub-versões na Apple">
                                                            <FontIcon Glyph="&#xE72C;" FontSize="10"/>
                                                        </Button>
                                                    </StackPanel>
                                                    <ComboBox x:ConnectionId='80' x:Name="CmbExactVersion"
                                                              HorizontalAlignment="Stretch"
                                                                                                                 />
                                                </StackPanel>

                                                <ComboBox x:ConnectionId='79' x:Name="CmbReleaseChannel"
                                                          Grid.Column="1"
                                                          Header="Canal de Download Apple"
                                                          HorizontalAlignment="Stretch"
                                                                                                               >
