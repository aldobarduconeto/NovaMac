                                    </Border>

                                    <TextBlock x:ConnectionId='77' x:Name="TxtCustomImageSelected"
                                               FontSize="11.5"
                                               Foreground="#30D158"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 2: HARDWARE & PROCESSING -->
                            <Border Background="{ThemeResource WorkspaceCardBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="2. Recursos de Processamento &amp; Memória"
                                               FontSize="15" FontWeight="SemiBold"/>

                                    <Grid ColumnSpacing="14" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBox x:ConnectionId='71' x:Name="TxtVmName"
                                                 Grid.Row="0" Grid.Column="0"
                                                 Header="Nome da VM"
                                                 Text="macOS Sequoia VM"/>

                                        <ComboBox x:ConnectionId='72' x:Name="CmbCpuCores"
                                                  Grid.Row="0" Grid.Column="1"
                                                  Header="Núcleos de CPU (vCPUs)"
                                                  HorizontalAlignment="Stretch"
                                                  SelectedIndex="1">
                                            <x:String>2 Núcleos</x:String>
                                            <x:String>4 Núcleos (Recomendado)</x:String>
                                            <x:String>6 Núcleos</x:String>
                                            <x:String>8 Núcleos</x:String>
                                            <x:String>12 Núcleos</x:String>
                                            <x:String>16 Núcleos</x:String>
                                        </ComboBox>

                                        <ComboBox x:ConnectionId='73' x:Name="CmbRamGb"
                                                  Grid.Row="0" Grid.Column="2"
                                                  Header="Memória RAM (GB)"
                                                  HorizontalAlignment="Stretch"
                                                  SelectedIndex="2">
                                            <x:String>4 GB</x:String>
                                            <x:String>6 GB</x:String>
                                            <x:String>8 GB (Recomendado)</x:String>
                                            <x:String>12 GB</x:String>
                                            <x:String>16 GB</x:String>
                                            <x:String>24 GB</x:String>
                                            <x:String>32 GB</x:String>
                                            <x:String>64 GB</x:String>
                                        </ComboBox>

                                        <ComboBox x:ConnectionId='74' x:Name="CmbCpuProfile"
                                                  Grid.Row="1" Grid.Column="0"
                                                  Header="Perfil de CPU QEMU"
                                                  HorizontalAlignment="Stretch"
                                                  SelectedIndex="0">
                                            <x:String>Cascadelake-Server (macOS 15 / 26 / 27)</x:String>
                                            <x:String>Haswell-noTSX (macOS 13 / 14)</x:String>
                                            <x:String>Penryn (macOS 11 / 12 Legado)</x:String>
                                        </ComboBox>

                                        <ToggleSwitch x:ConnectionId='75' x:Name="TglMountRecovery"
                                                      Grid.Row="1" Grid.Column="1"
                                                      Header="Mídia de Recuperação"
                                                      IsOn="True"
                                                      OnContent="Montada no Boot"
                                                      OffContent="Desconectada"/>

                                        <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="Aceleração WHPX" FontSize="11" Opacity="0.6"/>
                                            <TextBlock Text="Hipervisor Nativo Ativo" FontSize="12.5" FontWeight="SemiBold" Foreground="#30D158"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 3: STORAGE, VIDEO & NETWORKING -->
                            <Border Background="{ThemeResource WorkspaceCardBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="3. Armazenamento, Vídeo &amp; Conectividade"
                                               FontSize="15" FontWeight="SemiBold"/>

                                    <Grid ColumnSpacing="14" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ComboBox x:ConnectionId='61' x:Name="CmbDiskGb"
                                                  Grid.Row="0" Grid.Column="0"
                                                  Header="Disco Virtual (GB)"
                                                  HorizontalAlignment="Stretch"
                                                  SelectedIndex="1">
                                            <x:String>64 GB</x:String>
                                            <x:String>80 GB (Recomendado)</x:String>
                                            <x:String>120 GB</x:String>
                                            <x:String>200 GB</x:String>
                                            <x:String>500 GB</x:String>
                                            <x:String>1000 GB</x:String>
                                        </ComboBox>

                                        <ComboBox x:ConnectionId='62' x:Name="CmbResolution"
                                                  Grid.Row="0" Grid.Column="1"
                                                  Header="Resolução UEFI/OVMF"
                                                  HorizontalAlignment="Stretch"
                                                  SelectedIndex="1">
                                            <x:String>1600x900</x:String>
                                            <x:String>1920x1080 (Full HD)</x:String>
                                            <x:String>2560x1440 (QHD)</x:String>
                                            <x:String>3840x2160 (4K UHD)</x:String>
                                        </ComboBox>

                                        <ComboBox x:ConnectionId='63' x:Name="CmbVgaAdapter"
                                                  Grid.Row="0" Grid.Column="2"
                                                  Header="Controlador Gráfico (-vga)"
                                                  HorizontalAlignment="Stretch"
                                                  SelectedIndex="0">
                                            <x:String>std (Padrão VESA — Recomendado)</x:String>
                                            <x:String>vmware (VMware SVGA-II)</x:String>
                                            <x:String>virtio (VirtIO GPU)</x:String>
                                            <x:String>cirrus (Cirrus Logic)</x:String>
                                        </ComboBox>

                                        <ComboBox x:ConnectionId='64' x:Name="CmbNetworkCard"
                                                  Grid.Row="1" Grid.Column="0"
                                                  Header="Placa de Rede Virtual"
                                                  HorizontalAlignment="Stretch"
                                                  SelectedIndex="0">
                                            <x:String>vmxnet3 (VMware Paravirtualizado)</x:String>
                                            <x:String>e1000-82545em (Intel Gigabit)</x:String>
                                        </ComboBox>

                                        <TextBox x:ConnectionId='65' x:Name="TxtVmSshPort"
                                                 Grid.Row="1" Grid.Column="1"
                                                 Header="Porta SSH Host (localhost -> :22)"
                                                 Text="2222"/>

                                        <TextBox x:ConnectionId='66' x:Name="TxtVmVncPort"
                                                 Grid.Row="1" Grid.Column="2"
                                                 Header="Porta VNC Host (localhost -> :5900)"
                                                 Text="5900"/>

                                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:ConnectionId='69' x:Name="TxtSharedFolder"
                                                     Grid.Column="0"
                                                     Header="Pasta Compartilhada Windows (FAT/RW)"
                                                     PlaceholderText="Opcional — Ex: C:\Users\aldo\Downloads"/>
                                            <Button x:ConnectionId='70' Grid.Column="1"
                                                    Content="Procurar..."
                                                    VerticalAlignment="Bottom"
                                                                                       />
                                        </Grid>

                                        <ToggleSwitch x:ConnectionId='67' x:Name="TglEnableAudio"
                                                      Grid.Row="2" Grid.Column="2"
                                                      Header="Áudio Intel HDA"
                                                      IsOn="True"
                                                      OnContent="Ativado"
                                                      OffContent="Desativado"/>

                                        <ToggleSwitch x:ConnectionId='68' x:Name="TglFullscreen"
                                                      Grid.Row="3" Grid.ColumnSpan="3"
                                                      Header="Tela Cheia no QEMU"
                                                      OnContent="Tela Cheia"
                                                      OffContent="Em Janela"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 4: APPLE SMBIOS & OPENCORE -->
                            <Border Background="{ThemeResource WorkspaceCardBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <TextBlock Text="4. Identidade Apple (SMBIOS) &amp; OpenCore"
                                                   FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button x:ConnectionId='60' Content="Gerar Nova Identidade"
                                                HorizontalAlignment="Right"
                                                                                 />
                                    </Grid>

                                    <Grid ColumnSpacing="14" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ComboBox x:ConnectionId='53' x:Name="CmbSmbiosModel"
                                                  Grid.Row="0" Grid.Column="0"
                                                  Header="Modelo SMBIOS"
                                                  HorizontalAlignment="Stretch"
                                                  SelectedIndex="0">
                                            <x:String>MacPro7,1 (Mac Pro 2019 — macOS 15/26/27)</x:String>
                                            <x:String>iMacPro1,1 (iMac Pro 2017 — macOS 11 a 14)</x:String>
                                        </ComboBox>

                                        <TextBox x:ConnectionId='54' x:Name="TxtSerialNumber"
                                                 Grid.Row="0" Grid.Column="1"
                                                 Header="Número de Série (Serial)"
                                                 FontFamily="Consolas"/>

                                        <TextBox x:ConnectionId='55' x:Name="TxtBoardSerial"
                                                 Grid.Row="0" Grid.Column="2"
                                                 Header="Board Serial (MLB)"
                                                 FontFamily="Consolas"/>

                                        <TextBox x:ConnectionId='56' x:Name="TxtSystemUuid"
                                                 Grid.Row="1" Grid.Column="0"
                                                 Header="System UUID"
                                                 FontFamily="Consolas"/>

                                        <TextBox x:ConnectionId='57' x:Name="TxtRomMac"
                                                 Grid.Row="1" Grid.Column="1"
                                                 Header="MAC Address ROM"
                                                 FontFamily="Consolas"/>

                                        <TextBox x:ConnectionId='58' x:Name="TxtCustomQemuArgs"
                                                 Grid.Row="1" Grid.Column="2"
                                                 Header="Argumentos Extras QEMU"
                                                 PlaceholderText="Ex: -usb -device usb-host..."
                                                 FontFamily="Consolas"/>

                                        <TextBox x:ConnectionId='59' x:Name="TxtOpenCoreBootArgs"
                                                 Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                 Header="Argumentos de Boot OpenCore (boot-args)"
                                                 Text="-v keepsyms=1 debug=0x100 agdpmod=pikera revpatch=sbvmm,cpuname -lilubetaall -cryptbeta"
                                                 FontFamily="Consolas"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- SECTION 5: ACTION & PROGRESS FOOTER -->
                            <Border Background="{ThemeResource WorkspaceCardBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <StackPanel Spacing="10">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <ProgressRing x:ConnectionId='50' x:Name="CreationProgressRing" IsActive="False" Width="22" Height="22"/>
                                            <StackPanel>
                                                <TextBlock x:ConnectionId='51' x:Name="TxtProgressStage"
                                                           Text="Pronto para criar ou salvar as configurações da VM."
                                                           FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock x:ConnectionId='52' x:Name="TxtProgressDetails"
                                                           Text="O OpenCore, firmware OVMF e BaseSystem serão reutilizados do cache."
                                                           FontSize="11.5" Opacity="0.7"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                                            <Button x:ConnectionId='47' x:Name="BtnCancelCreation"
                                                    Content="Cancelar"
                                                    Visibility="Collapsed"
                                                                                   />

                                            <Button x:ConnectionId='48' x:Name="BtnSaveEditedVm"
                                                    Content="Salvar Alterações"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                    Visibility="Collapsed"
                                                                                 />

                                            <Button x:ConnectionId='49' x:Name="BtnCreateVm"
                                                    Content="Baixar macOS &amp; Criar VM"
                                                    Style="{StaticResource AccentButtonStyle}"
                                                                             />
                                        </StackPanel>
                                    </Grid>

                                    <ProgressBar x:ConnectionId='46' x:Name="CreationProgressBar" Minimum="0" Maximum="100" Value="0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== VIEW 3: DIAGNOSTICS ==================== -->
                    <ScrollViewer x:ConnectionId='12' x:Name="ViewDiagnostics" Grid.Row="1" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <StackPanel>
                                <TextBlock Text="Diagnóstico do Sistema" FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="Verifique os componentes de virtualização e o status do motor QEMU e hipervisor WHPX."
                                           FontSize="12.5" Opacity="0.7" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Status Cards Grid -->
                            <Grid ColumnSpacing="12" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: QEMU Engine -->
                                <Border Grid.Column="0"
                                        Background="{ThemeResource WorkspaceCardBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="16">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource AccentTintBrush}">
                                                <FontIcon Glyph="&#xE756;" FontSize="14" Foreground="#0A84FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Motor QEMU" FontSize="13.5" FontWeight="SemiBold"/>
                                                <TextBlock x:ConnectionId='45' x:Name="TxtDiagQemu" Text="Verificando..." FontSize="11.5" Opacity="0.8"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Executável:" FontSize="10.5" Opacity="0.6"/>
                                        <TextBlock x:ConnectionId='44' x:Name="TxtDiagQemuPath" Text="-" FontSize="10.5" FontFamily="Consolas" TextWrapping="Wrap" Opacity="0.8"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: WHPX Hypervisor -->
                                <Border Grid.Column="1"
                                        Background="{ThemeResource WorkspaceCardBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="16">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource AccentTintBrush}">
                                                <FontIcon Glyph="&#xE950;" FontSize="14" Foreground="#30D158" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Hipervisor Windows" FontSize="13.5" FontWeight="SemiBold"/>
                                                <TextBlock x:ConnectionId='43' x:Name="TxtDiagWhpx" Text="Verificando..." FontSize="11.5" Opacity="0.8"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Aceleração de hardware obrigatória para executar macOS com alta performance."
                                                   FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Host CPU -->
                                <Border Grid.Column="2"
                                        Background="{ThemeResource WorkspaceCardBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="16">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource AccentTintBrush}">
                                                <FontIcon Glyph="&#xE7F4;" FontSize="14" Foreground="#FF9F0A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Processador do Host" FontSize="13.5" FontWeight="SemiBold"/>
                                                <TextBlock x:ConnectionId='42' x:Name="TxtDiagCpu" Text="-" FontSize="11.5" Opacity="0.8" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="Suporte a instruções SSE4.2, AVX2 e virtualização de CPU."
                                                   FontSize="11" Opacity="0.7" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Diagnostic Actions -->
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                <Button x:ConnectionId='39'                                >
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                                        <TextBlock Text="Revalidar Diagnóstico"/>
                                    </StackPanel>
                                </Button>
                                <Button x:ConnectionId='40' Style="{StaticResource AccentButtonStyle}"
                                                                          >
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE896;" FontSize="12"/>
                                        <TextBlock Text="Instalar QEMU (Winget)"/>
                                    </StackPanel>
                                </Button>
                                <Button x:ConnectionId='41'                            >
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE7EF;" FontSize="12"/>
                                        <TextBlock Text="Ativar WHPX (PowerShell Admin)"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== VIEW 4: APP SETTINGS ==================== -->
                    <ScrollViewer x:ConnectionId='13' x:Name="ViewSettings" Grid.Row="1" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Configurações" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock Text="Personalize a aparência, caminhos de armazenamento e hardware padrão."
                                               FontSize="12.5" Opacity="0.7" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                    <Button x:ConnectionId='37' Content="Restaurar Padrões"                               />
                                    <Button x:ConnectionId='38' Content="Salvar Configurações"
                                            Style="{StaticResource AccentButtonStyle}"
                                                                         />
                                </StackPanel>
                            </Grid>

                            <!-- 1. APARÊNCIA & TEMA -->
                            <Border Background="{ThemeResource WorkspaceCardBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="1. Aparência Visual &amp; Material de Fundo" FontSize="15" FontWeight="SemiBold"/>

                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox x:ConnectionId='35' x:Name="CmbSettingsTheme"
                                                  Grid.Column="0"
                                                  Header="Tema do Aplicativo"
                                                  HorizontalAlignment="Stretch"
                                                                                                      >
                                            <ComboBoxItem Content="Padrão do Windows" Tag="Default"/>
                                            <ComboBoxItem Content="Modo Claro (Light)" Tag="Light"/>
                                            <ComboBoxItem Content="Modo Escuro (Dark)" Tag="Dark"/>
                                        </ComboBox>

                                        <ComboBox x:ConnectionId='36' x:Name="CmbSettingsBackdrop"
                                                  Grid.Column="1"
                                                  Header="Material de Fundo (Backdrop)"
                                                  HorizontalAlignment="Stretch"
                                                                                                         >
                                            <ComboBoxItem Content="Mica Alt (Suave)" Tag="MicaAlt"/>
                                            <ComboBoxItem Content="Mica Padrão (Windows 11)" Tag="Mica"/>
                                            <ComboBoxItem Content="Acrílico Translúcido" Tag="Acrylic"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 2. ARMAZENAMENTO & PASTAS -->
                            <Border Background="{ThemeResource WorkspaceCardBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="2. Pastas de Armazenamento de VMs &amp; Cache" FontSize="15" FontWeight="SemiBold"/>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:ConnectionId='32' x:Name="TxtSettingsVmsDir"
                                                 Grid.Column="0"
                                                 Header="Pasta dos Pacotes de VMs (.novavm)"
                                                 PlaceholderText="Padrão: %LOCALAPPDATA%\NovaMac\VMs"/>
                                        <Button x:ConnectionId='33' Grid.Column="1" Content="Procurar..." VerticalAlignment="Bottom"                              />
                                        <Button x:ConnectionId='34' Grid.Column="2" Content="Abrir" VerticalAlignment="Bottom"                            />
                                    </Grid>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:ConnectionId='28' x:Name="TxtSettingsCacheDir"
                                                 Grid.Column="0"
                                                 Header="Pasta de Cache de Imagens (Recovery, OpenCore, OVMF)"
                                                 PlaceholderText="Padrão: %LOCALAPPDATA%\NovaMac\Cache"/>
                                        <Button x:ConnectionId='29' Grid.Column="1" Content="Procurar..." VerticalAlignment="Bottom"                                />
                                        <Button x:ConnectionId='30' Grid.Column="2" Content="Abrir" VerticalAlignment="Bottom"                              />
                                        <Button x:ConnectionId='31' Grid.Column="3" Content="Limpar Cache" VerticalAlignment="Bottom"                            />
                                    </Grid>

                                    <TextBlock x:ConnectionId='27' x:Name="TxtCacheUsageInfo"
                                               Text="Calculando uso do cache..."
                                               FontSize="11.5"
                                               Opacity="0.7"/>
                                </StackPanel>
                            </Border>

                            <!-- 3. EXECUTÁVEIS DO QEMU -->
                            <Border Background="{ThemeResource WorkspaceCardBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="3. Executáveis do QEMU (Opcional — Auto-detectado)" FontSize="15" FontWeight="SemiBold"/>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:ConnectionId='25' x:Name="TxtSettingsQemuSys"
                                                 Grid.Column="0"
                                                 Header="Caminho para qemu-system-x86_64.exe"
                                                 PlaceholderText="Ex: C:\Program Files\qemu\qemu-system-x86_64.exe"/>
                                        <Button x:ConnectionId='26' Grid.Column="1" Content="Selecionar..." VerticalAlignment="Bottom"                               />
                                    </Grid>

                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:ConnectionId='23' x:Name="TxtSettingsQemuImg"
                                                 Grid.Column="0"
                                                 Header="Caminho para qemu-img.exe"
                                                 PlaceholderText="Ex: C:\Program Files\qemu\qemu-img.exe"/>
                                        <Button x:ConnectionId='24' Grid.Column="1" Content="Selecionar..." VerticalAlignment="Bottom"                               />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 4. PADRÕES PARA NOVAS VMS -->
                            <Border Background="{ThemeResource WorkspaceCardBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="4. Hardware Padrão para Novas VMs" FontSize="15" FontWeight="SemiBold"/>

                                    <Grid ColumnSpacing="14" RowSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBox x:ConnectionId='17' x:Name="TxtSettingsDefaultCores"
                                                 Grid.Row="0" Grid.Column="0"
                                                 Header="vCPUs Padrão"
                                                 Text="4"/>

                                        <TextBox x:ConnectionId='18' x:Name="TxtSettingsDefaultRam"
                                                 Grid.Row="0" Grid.Column="1"
                                                 Header="Memória RAM Padrão (GB)"
                                                 Text="8"/>

                                        <TextBox x:ConnectionId='19' x:Name="TxtSettingsDefaultDisk"
                                                 Grid.Row="0" Grid.Column="2"
                                                 Header="Disco Padrão (GB)"
                                                 Text="80"/>

                                        <ComboBox x:ConnectionId='20' x:Name="CmbSettingsDefaultResolution"
                                                  Grid.Row="1" Grid.Column="0"
                                                  Header="Resolução Padrão"
                                                  HorizontalAlignment="Stretch">
                                            <x:String>1600x900</x:String>
                                            <x:String>1920x1080</x:String>
                                            <x:String>2560x1440</x:String>
                                            <x:String>3840x2160</x:String>
                                        </ComboBox>

                                        <ToggleSwitch x:ConnectionId='21' x:Name="TglSettingsDefaultAudio"
                                                      Grid.Row="1" Grid.Column="1"
                                                      Header="Áudio Intel HDA"
                                                      IsOn="True"
                                                      OnContent="Ativado"
                                                      OffContent="Desativado"/>

                                        <ToggleSwitch x:ConnectionId='22' x:Name="TglSettingsDefaultFullscreen"
                                                      Grid.Row="1" Grid.Column="2"
                                                      Header="Tela Cheia para Novas VMs"
                                                      OnContent="Tela Cheia"
                                                      OffContent="Em Janela"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 5. REDE & PORTAS -->
                            <Border Background="{ThemeResource WorkspaceCardBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="5. Rede &amp; Portas Multi-VM" FontSize="15" FontWeight="SemiBold"/>

                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:ConnectionId='14' x:Name="TxtSettingsBaseSsh"
                                                 Grid.Column="0"
                                                 Header="Porta SSH Inicial"
                                                 Text="2222"/>

                                        <TextBox x:ConnectionId='15' x:Name="TxtSettingsBaseVnc"
                                                 Grid.Column="1"
                                                 Header="Porta VNC Inicial"
                                                 Text="5900"/>

                                        <ToggleSwitch x:ConnectionId='16' x:Name="TglSettingsAutoPorts"
                                                      Grid.Column="2"
                                                      Header="Portas Exclusivas por VM"
                                                      IsOn="True"
                                                      OnContent="Auto-incrementar"
                                                      OffContent="Porta Fixa"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </NavigationView>
    </Grid>
</Page>

