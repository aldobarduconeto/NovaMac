                                                      Grid.Row="1" Grid.Column="2"
                                                      Header="Áudio"
                                                      OnContent="Ativado"
                                                      OffContent="Desativado"/>

                                        <ToggleSwitch x:ConnectionId='25' x:Name="TglSettingsDefaultFullscreen"
                                                      Grid.Row="2" Grid.ColumnSpan="3"
                                                      Header="Tela cheia para novas VMs"
                                                      OnContent="Tela cheia"
                                                      OffContent="Em janela"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Background="{ThemeResource WorkspaceCardBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="22">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Rede e portas" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Defina as portas iniciais no Windows e como atribuí-las a novas VMs."
                                               Opacity="0.75" TextWrapping="Wrap"/>
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:ConnectionId='16' x:Name="TxtSettingsBaseSsh"
                                                 Grid.Row="0" Grid.Column="0"
                                                 Header="Porta SSH Inicial (Ex: 2222)"
                                                 Text="2222"/>

                                        <TextBox x:ConnectionId='17' x:Name="TxtSettingsBaseVnc"
                                                 Grid.Row="0" Grid.Column="1"
                                                 Header="Porta VNC/Screen Sharing Inicial (Ex: 5900)"
                                                 Text="5900"/>

                                        <ToggleSwitch x:ConnectionId='18' x:Name="TglSettingsAutoPorts"
                                                      Grid.Row="0" Grid.Column="2"
                                                      Header="Portas Exclusivas por VM"
                                                      IsOn="True"
                                                      OnContent="Auto-incrementar (Multi-VM)"
                                                      OffContent="Porta Fixa"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </NavigationView>
    </Grid>
</Page>

