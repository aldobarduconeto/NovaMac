<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NovaMac.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:NovaMac.Models"
    Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WorkspaceBrush" Color="#38F2F4F8"/>
                    <SolidColorBrush x:Key="WorkspaceCardBrush" Color="#B8FCFDFF"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WorkspaceBrush" Color="#40191B21"/>
                    <SolidColorBrush x:Key="WorkspaceCardBrush" Color="#A8242730"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="WorkspaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="WorkspaceCardBrush" Color="{ThemeResource SystemColorWindowColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Integrated Custom TitleBar -->
            <RowDefinition Height="44"/>
            <!-- Row 1: Main NavigationView & Content -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- ==================== INTEGRATED CUSTOM TITLE BAR ==================== -->
        <Grid x:ConnectionId='2' x:Name="AppTitleBar"
              Grid.Row="0"
              Background="Transparent"
              Padding="14,0,140,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,2,0">
                    <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="24" Height="24" Stretch="UniformToFill"/>
                </Border>
                <TextBlock Text="NovaMac" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>

                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="5"
                        Padding="7,2"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock x:ConnectionId='127' x:Name="TxtPaneSubtitle"
                               Text="Verificando QEMU e WHPX…"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Opacity="0.85"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ==================== MAIN NAVIGATION VIEW ==================== -->
        <NavigationView x:ConnectionId='3' x:Name="MainNav"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="232"
                                                                   >

            <NavigationView.MenuItems>
                <NavigationViewItemHeader Content="ESPAÇO DE TRABALHO"/>
                <NavigationViewItem x:ConnectionId='4' x:Name="NavItemLibrary" Content="Biblioteca" Tag="Library" Icon="AllApps" IsSelected="True"/>
                <NavigationViewItem x:ConnectionId='5' x:Name="NavItemVmEditor" Content="Editor de VMs" Tag="Create" Icon="Add"/>
                <NavigationViewItem x:ConnectionId='6' x:Name="NavItemDiagnostics" Content="Diagnóstico" Tag="Diagnostics" Icon="Repair"/>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItemHeader Content="PREFERÊNCIAS"/>
                <NavigationViewItem x:ConnectionId='7' Content="Modo Claro / Escuro" Tag="ToggleTheme" Icon="Highlight"                               />
                <NavigationViewItem x:ConnectionId='8' Content="Abrir Cache Recovery" Tag="OpenCache" Icon="Folder"                             />
                <NavigationViewItem x:ConnectionId='9' Content="Pasta de Pacotes de VMs" Tag="OpenVms" Icon="OpenLocal"                           />
                <NavigationViewItem x:ConnectionId='10' x:Name="NavItemSettings" Content="Configurações" Tag="Settings" Icon="Setting"/>
            </NavigationView.FooterMenuItems>

            <!-- MAIN CONTENT AREA -->
            <Border Margin="0,0,10,10"
                    CornerRadius="14"
                    Background="{ThemeResource WorkspaceBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid Padding="26,20,26,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- WinUI Native InfoBar -->
                    <InfoBar x:ConnectionId='11' x:Name="StatusInfoBar"
                             Grid.Row="0"
                             IsOpen="False"
                             IsClosable="True"
                             Margin="0,0,0,14"/>

                    <!-- ==================== VIEW 1: VM LIBRARY ==================== -->
                    <Grid x:ConnectionId='12' x:Name="ViewLibrary" Grid.Row="1" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0"
                                Background="{ThemeResource WorkspaceCardBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="20"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Máquinas virtuais" Style="{StaticResource TitleTextBlockStyle}"/>
                                    <TextBlock Text="Gerencie e execute suas máquinas virtuais macOS."
                                               FontSize="13" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                    <Button x:ConnectionId='124' x:Name="BtnQuickTheme"
                                            Content="Alternar Tema"
                                                                       
                                            ToolTipService.ToolTip="Alternar entre Modo Claro e Modo Escuro"/>
                                    <Button x:ConnectionId='125' Content="Atualizar"                            />
                                    <Button x:ConnectionId='126' Content="Nova VM"
                                            Style="{StaticResource AccentButtonStyle}"
                                                                            />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Filter Bar for Multi-VM Management -->
                        <Border Grid.Row="1"
                                Background="{ThemeResource WorkspaceCardBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,0,0,16">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:ConnectionId='121' x:Name="TxtSearchVms"
                                         Grid.Column="0"
                                         PlaceholderText="Pesquisar VM por nome, versão do macOS, SMBIOS ou porta SSH..."
                                                                               />

                                <ComboBox x:ConnectionId='122' x:Name="CmbFilterVersion"
                                          Grid.Column="1"
                                          HorizontalAlignment="Stretch"
                                          SelectedIndex="0"
                                                                                              >
                                    <x:String>Todas as Versões do macOS</x:String>
                                    <x:String>macOS 27</x:String>
                                    <x:String>macOS 26 Tahoe</x:String>
                                    <x:String>macOS Sequoia</x:String>
                                    <x:String>macOS Sonoma</x:String>
                                    <x:String>macOS Ventura</x:String>
                                    <x:String>macOS Monterey</x:String>
                                    <x:String>macOS Big Sur</x:String>
                                </ComboBox>

                                <TextBlock x:ConnectionId='123' x:Name="TxtVmCountSummary"
                                           Grid.Column="2"
                                           Text="0 de 0 VMs"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Opacity="0.75"
                                           Margin="4,0"/>
                            </Grid>
                        </Border>

                        <!-- Empty State Card (With Vector Apple Path instead of missing glyph box) -->
                        <Border x:ConnectionId='100' x:Name="EmptyLibraryCard"
                                Grid.Row="2"
                                Background="{ThemeResource WorkspaceCardBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="44,38"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" Spacing="14">
                                <Border Width="64" Height="64" CornerRadius="18" HorizontalAlignment="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0A84FF" Offset="0"/>
                                            <GradientStop Color="#5E5CE6" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Viewbox Width="30" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M11.6,7.2 C11.6,5.2 13.2,4.1 13.3,4.0 C12.3,2.6 10.8,2.4 10.3,2.4 C9.0,2.3 7.7,3.1 7.1,3.1 C6.4,3.1 5.4,2.4 4.3,2.4 C2.9,2.4 1.6,3.2 0.9,4.5 C-0.6,7.0 0.5,10.8 1.9,12.8 C2.6,13.8 3.4,14.9 4.5,14.9 C5.6,14.8 6.0,14.2 7.3,14.2 C8.5,14.2 8.9,14.9 10.0,14.8 C11.2,14.8 11.9,13.8 12.6,12.8 C13.4,11.6 13.7,10.5 13.7,10.4 C13.7,10.4 11.6,9.6 11.6,7.2 Z M9.4,1.3 C10.0,0.6 10.4,-0.4 10.3,-1.4 C9.4,-1.4 8.3,-0.8 7.7,-0.1 C7.2,0.5 6.7,1.5 6.8,2.5 C7.8,2.6 8.8,2.0 9.4,1.3 Z"
                                              Fill="White" Stretch="Uniform"/>
                                    </Viewbox>
                                </Border>

                                <TextBlock Text="Nenhuma Máquina Virtual macOS Encontrada"
                                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Você pode criar quantas máquinas virtuais desejar para diferentes versões do macOS (Big Sur 11, Monterey 12, Ventura 13, Sonoma 14, Sequoia 15, Tahoe 26 e macOS 27). Cada VM possui seu próprio disco NVMe, SMBIOS e porta SSH/VNC exclusiva."
                                           FontSize="13" Opacity="0.75" TextAlignment="Center" TextWrapping="Wrap"/>
                                <Button x:ConnectionId='120' Content="+ Criar Nova Máquina Virtual macOS"
                                        Style="{StaticResource AccentButtonStyle}"
                                        HorizontalAlignment="Center"
                                        Margin="0,6,0,0"
                                                                        />
                            </StackPanel>
                        </Border>

                        <!-- VM List -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:ConnectionId='101' x:Name="VmsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate                                         >
                                        <Border x:ConnectionId='103' Background="{ThemeResource WorkspaceCardBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="20,16"
                                                Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Vector Apple Badge -->
                                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="14"
                                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        BorderBrush="#0A84FF" BorderThickness="1.5"
                                                        Margin="0,0,18,0" VerticalAlignment="Center">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="3">
                                                        <Viewbox Width="16" Height="18" HorizontalAlignment="Center">
                                                            <Path Data="M11.6,7.2 C11.6,5.2 13.2,4.1 13.3,4.0 C12.3,2.6 10.8,2.4 10.3,2.4 C9.0,2.3 7.7,3.1 7.1,3.1 C6.4,3.1 5.4,2.4 4.3,2.4 C2.9,2.4 1.6,3.2 0.9,4.5 C-0.6,7.0 0.5,10.8 1.9,12.8 C2.6,13.8 3.4,14.9 4.5,14.9 C5.6,14.8 6.0,14.2 7.3,14.2 C8.5,14.2 8.9,14.9 10.0,14.8 C11.2,14.8 11.9,13.8 12.6,12.8 C13.4,11.6 13.7,10.5 13.7,10.4 C13.7,10.4 11.6,9.6 11.6,7.2 Z M9.4,1.3 C10.0,0.6 10.4,-0.4 10.3,-1.4 C9.4,-1.4 8.3,-0.8 7.7,-0.1 C7.2,0.5 6.7,1.5 6.8,2.5 C7.8,2.6 8.8,2.0 9.4,1.3 Z"
                                                                  Fill="#0A84FF" Stretch="Uniform"/>
                                                        </Viewbox>
                                                        <TextBlock x:ConnectionId='119'                              FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <TextBlock x:ConnectionId='116'                      FontSize="17" FontWeight="SemiBold"/>
                                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                            <TextBlock x:ConnectionId='118'                           FontSize="11" Foreground="#0A84FF" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                            <TextBlock x:ConnectionId='117'                                         FontSize="11"                                                   FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock x:ConnectionId='111'                              FontSize="13" Opacity="0.75"/>

                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="SMBIOS:" FontSize="11.5" Opacity="0.6"/>
                                                        <TextBlock x:ConnectionId='112'                             FontSize="11.5" FontWeight="SemiBold" Opacity="0.85"/>
                                                        <TextBlock Text="• Serial:" FontSize="11.5" Opacity="0.6"/>
                                                        <TextBlock x:ConnectionId='113'                              FontSize="11.5" FontFamily="Consolas" Opacity="0.85"/>
                                                        <TextBlock Text="• SSH:" FontSize="11.5" Opacity="0.6"/>
                                                        <TextBlock x:ConnectionId='114'                                FontSize="11.5" FontFamily="Consolas" Opacity="0.85"/>
                                                        <TextBlock Text="• VNC:" FontSize="11.5" Opacity="0.6"/>
                                                        <TextBlock x:ConnectionId='115'                                FontSize="11.5" FontFamily="Consolas" Opacity="0.85"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Actions -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                                                    <Button x:ConnectionId='104' Content="Iniciar"
                                                            Style="{StaticResource AccentButtonStyle}"
                                                                          
                                                                                                            
                                                                                    />
                                                    <Button x:ConnectionId='105' Content="Parar"
                                                                          
                                                                                                           
                                                                                   />
                                                    <Button x:ConnectionId='106' Content="Configurar VM"
                                                                          
                                                                                   
                                                            ToolTipService.ToolTip="Abrir Página Completa de Configurações desta Máquina Virtual"/>
                                                    <Button x:ConnectionId='107' Content="Clonar"
                                                                          
                                                                                    
                                                            ToolTipService.ToolTip="Duplicar esta VM com novo Serial e Porta SSH"/>
                                                    <Button x:ConnectionId='108' Content="QEMU"
                                                                          
                                                                                        
                                                            ToolTipService.ToolTip="Ver e Copiar Linha de Comando QEMU"/>
                                                    <Button x:ConnectionId='109' Content="Pasta"
                                                                          
                                                                                         
                                                            ToolTipService.ToolTip="Abrir Pasta do Pacote da VM"/>
                                                    <Button x:ConnectionId='110' Content="Excluir"
                                                                          
                                                                                     
                                                            ToolTipService.ToolTip="Excluir Máquina Virtual"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ==================== VIEW 2: DEDICATED VM CREATE & EDIT SETTINGS PAGE ==================== -->
                    <ScrollViewer x:ConnectionId='13' x:Name="ViewWizard" Grid.Row="1" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16">
                            <!-- Page Header with Mode Switching (Create New vs Edit Existing VM) -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock x:ConnectionId='98' x:Name="TxtVmEditorHeaderTitle"
                                                   Text="Criar Nova Máquina Virtual macOS"
                                                   FontSize="26"
                                                   FontWeight="Bold"/>
                                        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="6"
                                                Padding="10,4"
                                                VerticalAlignment="Center">
                                            <TextBlock x:ConnectionId='99' x:Name="TxtVmEditorModeBadge"
                                                       Text="MODO CRIAÇÃO"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#0A84FF"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:ConnectionId='97' x:Name="TxtVmEditorSubtitle"
                                               Text="Configure todos os parâmetros de sistema operacional, CPU, RAM, disco NVMe, vídeo UEFI, portas de rede, SMBIOS e OpenCore da máquina virtual."
                                               FontSize="13" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                                    <Button x:ConnectionId='95' x:Name="BtnSwitchToCreateMode"
                                            Content="+ Limpar / Modo Nova VM"
                                            Visibility="Collapsed"
                                                                            />
                                    <Button x:ConnectionId='96' Content="Voltar para Biblioteca"
                                                                          />
                                </StackPanel>
                            </Grid>

                            <!-- SECTION 1: OS VERSION & BOOTLOADER -->
                            <Border Background="{ThemeResource WorkspaceCardBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="20">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="16" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="1. Sistema Operacional macOS &amp; Imagem de Instalação"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="8"
                                                    VerticalAlignment="Center">
                                            <Button x:ConnectionId='93'                                        
                                                    ToolTipService.ToolTip="Consultar todos os instaladores InstallAssistant.pkg oficiais da Apple">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="#0A84FF"/>
                                                    <TextBlock Text="Catálogo Apple"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:ConnectionId='94'                                   
                                                    ToolTipService.ToolTip="Selecionar imagem local (.dmg, .iso, .img)">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xED25;" FontSize="13" Foreground="#30D158"/>
                                                    <TextBlock Text="Imagem Local..."/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <GridView x:ConnectionId='80' x:Name="CatalogGridView"
                                              SelectionMode="Single"
                                                                                                 >
                                        <GridView.ItemTemplate>
                                            <DataTemplate                                 >
                                                <Border x:ConnectionId='88' Width="292"
                                                        Padding="14,12"
                                                        Margin="4"
                                                        CornerRadius="10"
                                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1">
                                                    <StackPanel Spacing="6">
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Viewbox Width="13" Height="15" VerticalAlignment="Center">
                                                                    <Path Data="M11.6,7.2 C11.6,5.2 13.2,4.1 13.3,4.0 C12.3,2.6 10.8,2.4 10.3,2.4 C9.0,2.3 7.7,3.1 7.1,3.1 C6.4,3.1 5.4,2.4 4.3,2.4 C2.9,2.4 1.6,3.2 0.9,4.5 C-0.6,7.0 0.5,10.8 1.9,12.8 C2.6,13.8 3.4,14.9 4.5,14.9 C5.6,14.8 6.0,14.2 7.3,14.2 C8.5,14.2 8.9,14.9 10.0,14.8 C11.2,14.8 11.9,13.8 12.6,12.8 C13.4,11.6 13.7,10.5 13.7,10.4 C13.7,10.4 11.6,9.6 11.6,7.2 Z M9.4,1.3 C10.0,0.6 10.4,-0.4 10.3,-1.4 C9.4,-1.4 8.3,-0.8 7.7,-0.1 C7.2,0.5 6.7,1.5 6.8,2.5 C7.8,2.6 8.8,2.0 9.4,1.3 Z"
                                                                          Fill="#0A84FF" Stretch="Uniform"/>
                                                                </Viewbox>
                                                                <TextBlock x:ConnectionId='92'                      FontSize="14.5" FontWeight="SemiBold"/>
                                                            </StackPanel>
                                                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="5" Padding="6,2" HorizontalAlignment="Right">
                                                                <TextBlock x:ConnectionId='91'                           FontSize="10.5" Foreground="#0A84FF" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                        <TextBlock x:ConnectionId='89'                         
                                                                   FontSize="11.5"
                                                                   Opacity="0.75"
                                                                   TextWrapping="Wrap"
                                                                   Height="34"/>
                                                        <TextBlock x:ConnectionId='90'                         FontSize="10.5" Opacity="0.55" FontFamily="Consolas"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </GridView.ItemTemplate>
                                    </GridView>

                                    <!-- SUB-VERSION & SEED CHANNEL SELECTOR -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="16,14">
                                        <StackPanel Spacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE713;" FontSize="15" Foreground="#0A84FF"/>
                                                <TextBlock Text="Versão Específica do macOS &amp; Canal de Distribuição"
                                                           FontSize="13.5" FontWeight="SemiBold"/>
                                            </StackPanel>

                                            <Grid ColumnSpacing="14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.3*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="6">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="Versão Exata / Build / Beta"
                                                                   FontSize="12"
                                                                   FontWeight="Medium"/>
                                                        <ProgressRing x:ConnectionId='85' x:Name="PrgLoadingVersions"
                                                                      Width="14" Height="14"
                                                                      IsActive="False"
                                                                      Visibility="Collapsed"/>
                                                        <Button x:ConnectionId='86' x:Name="BtnRefreshSubVersions"
                                                                                                   
                                                                Padding="4,2"
                                                                ToolTipService.ToolTip="Consultar sub-versões na Apple novamente">
                                                            <FontIcon Glyph="&#xE72C;" FontSize="11"/>
                                                        </Button>
                                                    </StackPanel>
                                                    <ComboBox x:ConnectionId='84' x:Name="CmbExactVersion"
                                                              HorizontalAlignment="Stretch"
                                                                                                                 />
                                                </StackPanel>

                                                <ComboBox x:ConnectionId='83' x:Name="CmbReleaseChannel"
                                                          Grid.Column="1"
                                                          Header="Canal de Download Apple"
                                                          HorizontalAlignment="Stretch"
                                                                                                               >
                                                    <ComboBoxItem Content="Estável Oficial (Default)" Tag="default"/>
                                                    <ComboBoxItem Content="Developer Seed / Beta (Latest)" Tag="latest"/>
                                                    <ComboBoxItem Content="Instalador Oficial Apple (InstallAssistant)" Tag="installer"/>
                                                </ComboBox>
                                            </Grid>

                                            <TextBlock x:ConnectionId='82' x:Name="TxtVersionDetails"
                                                       FontSize="11.5"
                                                       Opacity="0.75"
